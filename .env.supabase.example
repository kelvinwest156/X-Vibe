# ==============================================================================
# Supabase Configuration for X-VibeBot Creator Studio
# Copy these values into your `.env` (backend) and `frontend/.env.local` (Next.js)
# ==============================================================================

# Supabase Project URL & Anon Key (from Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase JWT Secret (from Supabase Dashboard -> Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# PostgreSQL Database Connection String (from Supabase Dashboard -> Settings -> Database -> Connection URI)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Google Gemini AI Key
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash

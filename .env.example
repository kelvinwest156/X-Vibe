# Google Gemini AI Configuration (Recommended — Free Tier Available)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek AI Configuration (Optional alternative)
# Get your key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Agent Run Configuration
AUTO_PILOT_MODE=false
POLLING_INTERVAL_MINUTES=15
DAILY_ACTION_CAP=15
MIN_COOLDOWN_MINUTES=15

# Browser Configuration
# Set HEADLESS=false on initial run to log into X (Twitter) manually!
HEADLESS=false
BROWSER_PROFILE_DIR=./data/browser_profiles/x_browser_profile

# Cloud Residential Proxy Configuration (Essential for production cloud hosting on Render/AWS)
# Supports standard HTTP, HTTPS, and SOCKS5 proxies
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Security & Authentication Secrets (Required in production)
# Generate a strong 64-char key with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=x-vibebot-creator-studio-secret-key-salt-2026
ENVIRONMENT=development

# Database Configuration (SQLite for local dev, PostgreSQL/Supabase for production)
# SQLite default: sqlite:///./vibebot.db
# Supabase example: postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./vibebot.db

# Target keywords or search term on X (e.g. #buildinpublic, AI engineering)
TARGET_SEARCH_QUERY=buildinpublic OR "ai engineering" OR "python dev"

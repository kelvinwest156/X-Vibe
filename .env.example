# DeepSeek AI Configuration
# Get your key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Agent Run Configuration
AUTO_PILOT_MODE=false
POLLING_INTERVAL_MINUTES=15
DAILY_ACTION_CAP=15
MIN_COOLDOWN_MINUTES=15

# Browser Configuration
# Set HEADLESS=false on initial run to log into X (Twitter) manually!
HEADLESS=false
BROWSER_PROFILE_DIR=./x_browser_profile

# Target keywords or search term on X (e.g. #buildinpublic, AI engineering)
TARGET_SEARCH_QUERY=buildinpublic OR "ai engineering" OR "python dev"
